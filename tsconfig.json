{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "dist",
    "rootDir": ".",
    "resolveJsonModule": true,
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "tests/**/*.ts"],
  "exclude": [
    "src/commands/commandRegistry.ts",
    "src/connection/messageRouter.ts",
    "src/game/economy.ts",
    "src/game/progression.ts",
    "src/game/properties.ts",
    "src/game/vehicles.ts",
    "src/game/businessSystem.ts",
    "src/game/war.ts"
  ]
}
