# Copy to `.env` (git-ignored) for local runs, or set these as real env vars on
# your host (Railway / Docker / systemd). Real env vars always win over the file.

# ── SynAI boost chain (§1): tried in order, first usable answer wins ──
# 1 Groq · 2 OpenRouter · 3 Cloudflare · 4 NVIDIA · 5 Cerebras (paid, only if 1-4 failed) · 6 HuggingFace (last resort)
GROQ_API_KEY=
# OpenRouter key for the SYN AI live boost. Get one at https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Optional: pin a specific model instead of the free auto-router.
# OPENROUTER_MODEL=openrouter/free

# Optional OpenRouter attribution (shows in the OpenRouter dashboard).
# OPENROUTER_REFERER=https://github.com/Exodialx/Syn-Bot
# OPENROUTER_TITLE=Syn Bot
# Cloudflare Workers AI (own parsing branch: result.response)
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=
# NVIDIA NIM — model IDs get retired without notice, health-check if 404s persist
# NVIDIA_API_KEY=
# Cerebras — PAID credit, only called when providers 1-4 all failed
# CEREBRAS_API_KEY=
# HuggingFace — free tier ~$0.10/mo, true last resort
# HUGGINGFACE_API_KEY=
